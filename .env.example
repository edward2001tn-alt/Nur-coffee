# Copy to .env. Never commit real secrets.
APP_ENV=development            # development | staging | production
DATABASE_URL=postgresql://nur:nur_local_dev@127.0.0.1:54329/nur
TEST_DATABASE_URL=postgresql://nur:nur_local_dev@127.0.0.1:54329/nur_test
APP_BASE_URL=http://localhost:3000

# Demo data & sandbox providers are refused when APP_ENV=production.
ENABLE_DEMO=true

# Sandbox payment provider (HMAC-signed webhooks). Replace with VNPay/MoMo/ZaloPay/bank adapter after contract.
SANDBOX_PAY_SECRET=change-me-local-only
SANDBOX_PAY_MERCHANT=NUR-SANDBOX-001

# Private file storage (local disk in dev; S3-compatible object storage in staging/prod)
FILE_STORAGE_DIR=.data/files
FILE_URL_SIGNING_SECRET=change-me-local-only

# Notification providers — unset => messages go to the labelled test sink only
EMAIL_PROVIDER=
SMS_PROVIDER=
